<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="label" for="node" attr.name="label" attr.type="string" /><key id="entity_type" for="node" attr.name="entity_type" attr.type="string" /><key id="bipartite" for="node" attr.name="bipartite" attr.type="int" /><key id="species" for="node" attr.name="species" attr.type="string" /><key id="ambiguity" for="node" attr.name="ambiguity" attr.type="string" /><key id="status" for="edge" attr.name="status" attr.type="string" /><key id="relation_type" for="edge" attr.name="relation_type" attr.type="string" /><key id="source_scope" for="edge" attr.name="source_scope" attr.type="string" /><key id="evidence_ids" for="edge" attr.name="evidence_ids" attr.type="string" /><key id="evidence" for="edge" attr.name="evidence" attr.type="string" /><key id="conditions" for="edge" attr.name="conditions" attr.type="string" /><key id="reason" for="edge" attr.name="reason" attr.type="string" /><graph id="PMC10014009" edgedefault="undirected"><node id="D01"><data key="label">cerebral cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类；b0099另用于动物模型</data><data key="ambiguity">CMM合并未经作者勘误；疾病作基因集合修饰语的提及不算病例证据。</data></node><node id="D02"><data key="label">familial cerebral cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D03"><data key="label">sporadic cerebral cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D04"><data key="label">spinal cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D05"><data key="label">cutaneous cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D06"><data key="label">cavernous angioma with symptomatic hemorrhage</data><data key="entity_type">clinical_event</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity">本轮明确纳入主矩阵的病变伴症状性出血复合事件；不与所有CCM或一般出血合并。</data></node><node id="D07"><data key="label">small vessel disease</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D08"><data key="label">diffuse axonal injury</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D09"><data key="label">intracerebral hemorrhage</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D10"><data key="label">developmental venous anomaly</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity">队列无人患病，不代表基因关联阴性。</data></node><node id="D11"><data key="label">tumor</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity">tumorous condition为当时影像疑诊，不能改成病理确诊。</data></node><node id="D12"><data key="label">breast cancer</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D13"><data key="label">thyroid cancer</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D14"><data key="label">diffuse midline glioma</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D15"><data key="label">adrenal adenoma</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D16"><data key="label">left anterior cerebral artery infarction</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D17"><data key="label">occipital lobe epilepsy</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity" /></node><node id="D18"><data key="label">PLE</data><data key="entity_type">ambiguous</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity">不能补成某种癫痫，不能与OLE合并；本轮纳入候选矩阵，identity未解决。</data></node><node id="D19"><data key="label">cavernous malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类</data><data key="ambiguity">部位可由上下文补足的CM提及另作回指，不一律作部位未明。</data></node><node id="D20"><data key="label">vascular malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类/一般机制描述</data><data key="ambiguity">b0011抑制机制未知；b0100为蛋白功能推测。</data></node><node id="D21"><data key="label">intracranial vascular malformation</data><data key="entity_type">disease</data><data key="bipartite">1</data><data key="species">人类疾病定义</data><data key="ambiguity" /></node><node id="G01"><data key="label">KRIT1</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">Homo sapiens；本研究为患者血样测序</data><data key="ambiguity">疑似排字错误尚无作者勘误确认；KRIT1 protein为产物提及。</data></node><node id="G02"><data key="label">CCM2</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">Homo sapiens；本研究为患者血样测序</data><data key="ambiguity" /></node><node id="G03"><data key="label">PDCD10</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">Homo sapiens；本研究为患者血样测序</data><data key="ambiguity" /></node><node id="G04"><data key="label">ZPLD1</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">人类FCCM背景语境，原句未显式标注物种</data><data key="ambiguity">未纳入本研究面板；proposed关联的证据性质未解决。</data></node><node id="G05"><data key="label">MAP3K3</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">人类散发CCM患者背景语境</data><data key="ambiguity">MEKK3不是第二个独立基因节点。</data></node><node id="G06"><data key="label">Krit1</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">非人动物模型；具体物种未注明</data><data key="ambiguity">不根据大小写猜测小鼠；具体物种与跨物种映射未确认。</data></node><node id="G07"><data key="label">Ccm2</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">非人动物模型；具体物种未注明</data><data key="ambiguity">不根据大小写猜测小鼠；具体物种与跨物种映射未确认。</data></node><node id="G08"><data key="label">Pdcd10</data><data key="entity_type">gene</data><data key="bipartite">0</data><data key="species">非人动物模型；具体物种未注明</data><data key="ambiguity">不根据大小写猜测小鼠；具体物种与跨物种映射未确认。</data></node><edge id="ED01" source="G01" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV001"]</data><data key="evidence">[{"evidence_id": "EV001", "paper_id": "PMC10014009", "quote": "These prior studies demonstrated that the products of the three genes (KRIT1, CCM2, and PDCD10) are associated with CCM form complexes. Loss of function (LOF) of these genes leads to the formation of CCM.", "location": "b0011", "section": "Body / Introduction", "start": 640, "end": 844, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因的LOF导致CCM；these genes由前句逐一指定。", "conditions": {"species": "human context", "variant_class": "LOF"}}]</data><data key="conditions">背景机制陈述；不指任意变异或所有散发病例；未独立阅读被引研究。</data><data key="reason">原文在一般CCM层面明确将三基因LOF与形成CCM相连，不是由FCCM关系自动向上推广。</data></edge><edge id="ED02" source="G01" target="D02"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV002"]</data><data key="evidence">[{"evidence_id": "EV002", "paper_id": "PMC10014009", "quote": "Familial CCM (FCCM) is an autosomal dominant disorder caused by mutations in three genes, KRIT1, CCM2, and PDCD10.", "location": "b0011", "section": "Body / Introduction", "start": 201, "end": 315, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因与FCCM的明确背景因果陈述。", "conditions": {}}]</data><data key="conditions">限原文致病变异语境；未检出变异病例不排除关系。</data><data key="reason">背景直接陈述FCCM由指定基因突变导致；本研究病例结果另存观察，不误写成本研究新验证因果。</data></edge><edge id="ED03" source="G02" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV001"]</data><data key="evidence">[{"evidence_id": "EV001", "paper_id": "PMC10014009", "quote": "These prior studies demonstrated that the products of the three genes (KRIT1, CCM2, and PDCD10) are associated with CCM form complexes. Loss of function (LOF) of these genes leads to the formation of CCM.", "location": "b0011", "section": "Body / Introduction", "start": 640, "end": 844, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因的LOF导致CCM；these genes由前句逐一指定。", "conditions": {"species": "human context", "variant_class": "LOF"}}]</data><data key="conditions">背景机制陈述；不指任意变异或所有散发病例；未独立阅读被引研究。</data><data key="reason">原文在一般CCM层面明确将三基因LOF与形成CCM相连，不是由FCCM关系自动向上推广。</data></edge><edge id="ED04" source="G02" target="D02"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV002"]</data><data key="evidence">[{"evidence_id": "EV002", "paper_id": "PMC10014009", "quote": "Familial CCM (FCCM) is an autosomal dominant disorder caused by mutations in three genes, KRIT1, CCM2, and PDCD10.", "location": "b0011", "section": "Body / Introduction", "start": 201, "end": 315, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因与FCCM的明确背景因果陈述。", "conditions": {}}]</data><data key="conditions">限原文致病变异语境；未检出变异病例不排除关系。</data><data key="reason">背景直接陈述FCCM由指定基因突变导致；本研究病例结果另存观察，不误写成本研究新验证因果。</data></edge><edge id="ED05" source="G03" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV001"]</data><data key="evidence">[{"evidence_id": "EV001", "paper_id": "PMC10014009", "quote": "These prior studies demonstrated that the products of the three genes (KRIT1, CCM2, and PDCD10) are associated with CCM form complexes. Loss of function (LOF) of these genes leads to the formation of CCM.", "location": "b0011", "section": "Body / Introduction", "start": 640, "end": 844, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因的LOF导致CCM；these genes由前句逐一指定。", "conditions": {"species": "human context", "variant_class": "LOF"}}]</data><data key="conditions">背景机制陈述；不指任意变异或所有散发病例；未独立阅读被引研究。</data><data key="reason">原文在一般CCM层面明确将三基因LOF与形成CCM相连，不是由FCCM关系自动向上推广。</data></edge><edge id="ED06" source="G03" target="D02"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV002"]</data><data key="evidence">[{"evidence_id": "EV002", "paper_id": "PMC10014009", "quote": "Familial CCM (FCCM) is an autosomal dominant disorder caused by mutations in three genes, KRIT1, CCM2, and PDCD10.", "location": "b0011", "section": "Body / Introduction", "start": 201, "end": 315, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个人类基因与FCCM的明确背景因果陈述。", "conditions": {}}]</data><data key="conditions">限原文致病变异语境；未检出变异病例不排除关系。</data><data key="reason">背景直接陈述FCCM由指定基因突变导致；本研究病例结果另存观察，不误写成本研究新验证因果。</data></edge><edge id="ED07" source="G05" target="D03"><data key="status">supported</data><data key="relation_type">association</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV005", "EV006"]</data><data key="evidence">[{"evidence_id": "EV005", "paper_id": "PMC10014009", "quote": "Moreover, gain-of-function (GOF) mutations in MAP3K3, encoding MEKK3, have been confirmed in sporadic CCM patients.", "location": "b0098", "section": "Body / Discussion", "start": 1397, "end": 1512, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "明确散发CCM患者中的MAP3K3功能获得变异报告。", "conditions": {"variant_class": "GOF", "disease_subtype": "sporadic CCM"}}, {"evidence_id": "EV006", "paper_id": "PMC10014009", "quote": "LOF in CCM genes and GOF in MAP3K3 are mutually exclusive, and the researchers suggested that CCM complexes suppress the activity of MEKK3.", "location": "b0098", "section": "Body / Discussion", "start": 1516, "end": 1655, "source_scope": "背景引用", "assertion_kind": "interpretation", "supports": "互斥模式及机制解释与前句联合支持保守association；不独立证明因果。", "conditions": {}}]</data><data key="conditions">没有升级为本研究因果；不传播到家族性或整个上位疾病。</data><data key="reason">联合确认的功能获得变异、特定散发患者范围及与CCM基因LOF的互斥模式，超过一般共现；保守作背景关联。</data></edge><edge id="ED08" source="G06" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV007"]</data><data key="evidence">[{"evidence_id": "EV007", "paper_id": "PMC10014009", "quote": "Some preclinical studies have demonstrated that the CCM animal model induced by Krit1, Ccm2, or Pdcd10 heterozygous loss in the immediate postnatal period, tended to harbor lesions in the hindbrain.", "location": "b0099", "section": "Body / Discussion", "start": 280, "end": 478, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个动物模型基因的杂合缺失诱导CCM模型。", "conditions": {"species": "animal, unspecified", "timing": "immediate postnatal period", "intervention": "heterozygous loss"}}]</data><data key="conditions">动物具体物种未知；出生后早期杂合缺失；不等同人类致病。</data><data key="reason">原文明确用指定动物基因杂合缺失诱导CCM动物模型；支持严格限定的模型因果。</data></edge><edge id="ED09" source="G07" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV007"]</data><data key="evidence">[{"evidence_id": "EV007", "paper_id": "PMC10014009", "quote": "Some preclinical studies have demonstrated that the CCM animal model induced by Krit1, Ccm2, or Pdcd10 heterozygous loss in the immediate postnatal period, tended to harbor lesions in the hindbrain.", "location": "b0099", "section": "Body / Discussion", "start": 280, "end": 478, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个动物模型基因的杂合缺失诱导CCM模型。", "conditions": {"species": "animal, unspecified", "timing": "immediate postnatal period", "intervention": "heterozygous loss"}}]</data><data key="conditions">动物具体物种未知；出生后早期杂合缺失；不等同人类致病。</data><data key="reason">原文明确用指定动物基因杂合缺失诱导CCM动物模型；支持严格限定的模型因果。</data></edge><edge id="ED10" source="G08" target="D01"><data key="status">supported</data><data key="relation_type">causal</data><data key="source_scope">背景引用</data><data key="evidence_ids">["EV007"]</data><data key="evidence">[{"evidence_id": "EV007", "paper_id": "PMC10014009", "quote": "Some preclinical studies have demonstrated that the CCM animal model induced by Krit1, Ccm2, or Pdcd10 heterozygous loss in the immediate postnatal period, tended to harbor lesions in the hindbrain.", "location": "b0099", "section": "Body / Discussion", "start": 280, "end": 478, "source_scope": "背景引用", "assertion_kind": "background_relation_statement", "supports": "三个动物模型基因的杂合缺失诱导CCM模型。", "conditions": {"species": "animal, unspecified", "timing": "immediate postnatal period", "intervention": "heterozygous loss"}}]</data><data key="conditions">动物具体物种未知；出生后早期杂合缺失；不等同人类致病。</data><data key="reason">原文明确用指定动物基因杂合缺失诱导CCM动物模型；支持严格限定的模型因果。</data></edge></graph></graphml>