    <node id="G04"><data key="n_name">ZPLD1</data><data key="n_bipartite">gene</data><data key="n_entity_type">gene</data><data key="n_species">human (only through human patient context; not explicitly stated)</data><data key="n_ambiguity">Only in a cited finding (ref. 15).</data></node>
    <node id="G05"><data key="n_name">MAP3K3</data><data key="n_bipartite">gene</data><data key="n_entity_type">gene</data><data key="n_species">human (only through human patient context; not explicitly stated)</data><data key="n_ambiguity"></data></node>
