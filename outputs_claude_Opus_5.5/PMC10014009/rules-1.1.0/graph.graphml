    <edge id="G01-D01" source="G01" target="D01"><data key="e_edge_id">G01-D01</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E03</data><data key="e_location">b0011 (Body / Introduction; chars 640-844)</data><data key="e_reason">Direct background statement about CCM (not propagated from FCCM). The 2-hit sentence (E12) uses the gene-set term &#x27;CCM genes&#x27; and is kept as context only.</data></edge>
    <edge id="G01-D02" source="G01" target="D02"><data key="e_edge_id">G01-D02</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E01,E02,E04,E06,E07</data><data key="e_location">b0011 (Body / Introduction; chars 201-315) || b0003 (Abstract / Objective; chars 0-163) || b0028 (Body / Result / Study population; chars 0-158) || b0070 (Body / Result / Detailed clinical, genetic data, and age-related disease burden of gene-confirmed FCCM patients; chars 154-441) || b0070 (Body / Result / Detailed clinical, genetic data, and age-related disease burden of gene-confirmed FCCM patients; chars 1034-1140)</data><data key="e_reason">R3: highest-level claim is causal and comes from the authors&#x27; background statement, so source_scope = background. This study adds an association claim (variant detection, family co-segregation), not causal evidence. Age-lesion correlations by gene group are study finding SF4, not this pair.</data></edge>
    <edge id="G02-D01" source="G02" target="D01"><data key="e_edge_id">G02-D01</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E03</data><data key="e_location">b0011 (Body / Introduction; chars 640-844)</data><data key="e_reason">Direct background statement about CCM (not propagated from FCCM). The 2-hit sentence (E12) uses the gene-set term &#x27;CCM genes&#x27; and is kept as context only.</data></edge>
    <edge id="G02-D02" source="G02" target="D02"><data key="e_edge_id">G02-D02</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E01,E02,E04,E08,E10</data><data key="e_location">b0011 (Body / Introduction; chars 201-315) || b0003 (Abstract / Objective; chars 0-163) || b0028 (Body / Result / Study population; chars 0-158) || b0070 (Body / Result / Detailed clinical, genetic data, and age-related disease burden of gene-confirmed FCCM patients; chars 838-933) || b0101 (Body / Discussion; chars 495-569)</data><data key="e_reason">R3: highest-level claim is causal and comes from the authors&#x27; background statement, so source_scope = background. This study adds an association claim (variant detection), not causal evidence. Age-lesion correlations by gene group are study finding SF4, not this pair.</data></edge>
    <edge id="G03-D01" source="G03" target="D01"><data key="e_edge_id">G03-D01</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E03</data><data key="e_location">b0011 (Body / Introduction; chars 640-844)</data><data key="e_reason">Direct background statement about CCM (not propagated from FCCM). The 2-hit sentence (E12) uses the gene-set term &#x27;CCM genes&#x27; and is kept as context only.</data></edge>
    <edge id="G03-D02" source="G03" target="D02"><data key="e_edge_id">G03-D02</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E01,E02,E04,E06,E07,E11</data><data key="e_location">b0011 (Body / Introduction; chars 201-315) || b0003 (Abstract / Objective; chars 0-163) || b0028 (Body / Result / Study population; chars 0-158) || b0070 (Body / Result / Detailed clinical, genetic data, and age-related disease burden of gene-confirmed FCCM patients; chars 154-441) || b0070 (Body / Result / Detailed clinical, genetic data, and age-related disease burden of gene-confirmed FCCM patients; chars 1034-1140) || b0101 (Body / Discussion; chars 871-949)</data><data key="e_reason">R3: highest-level claim is causal and comes from the authors&#x27; background statement, so source_scope = background. This study adds an association claim (variant detection, family co-segregation), not causal evidence. Age-lesion correlations by gene group are study finding SF4, not this pair.</data></edge>
    <edge id="G04-D02" source="G04" target="D02"><data key="e_edge_id">G04-D02</data><data key="e_status">supported</data><data key="e_relation_type">association</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E16</data><data key="e_location">b0098 (Body / Discussion; chars 1032-1112)</data><data key="e_reason">R4 row 2: reporting verb (&#x27;proposed&#x27;) attributing a conclusion to a cited study -&gt; supported / background.</data></edge>
    <edge id="G05-D03" source="G05" target="D03"><data key="e_edge_id">G05-D03</data><data key="e_status">supported</data><data key="e_relation_type">association</data><data key="e_source_scope">background</data><data key="e_evidence_species">human</data><data key="e_model_type"></data><data key="e_evidence_ids">E13</data><data key="e_location">b0098 (Body / Discussion; chars 1397-1515)</data><data key="e_reason">R4 row 1: stated prior finding. Association (mutations found in patients), no causal wording.</data></edge>
    <edge id="G06-D01" source="G06" target="D01"><data key="e_edge_id">G06-D01</data><data key="e_status">supported</data><data key="e_relation_type">causal</data><data key="e_source_scope">background</data><data key="e_evidence_species">non-human</data><data key="e_model_type">heterozygous loss in the immediate postnatal period</data><data key="e_evidence_ids">E20</data><data key="e_location">b0099 (Body / Discussion; chars 280-486)</data><data key="e_reason">R2: the text explicitly names a CCM animal model induced by this gene&#x27;s loss -&gt; edge to the CCM node, marked non-human. R3: induced model counts as causal.</data></edge>
