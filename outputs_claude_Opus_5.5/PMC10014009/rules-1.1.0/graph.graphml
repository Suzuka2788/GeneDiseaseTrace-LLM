  <graph id="G" edgedefault="undirected">
    <node id="G01"><data key="n_name">KRIT1</data><data key="n_bipartite">gene</data><data key="n_entity_type">gene</data><data key="n_species">Homo sapiens (patient germline testing)</data><data key="n_ambiguity">&#x27;KRIT1 protein ankyrin component&#x27; (b0100) is a protein-product mention.</data></node>
    <node id="G02"><data key="n_name">CCM2</data><data key="n_bipartite">gene</data><data key="n_entity_type">gene</data><data key="n_species">Homo sapiens (patient germline testing)</data><data key="n_ambiguity">Shares the &#x27;CCM&#x27; prefix with the disease abbreviation; every occurrence denotes the gene or its carrier group.</data></node>
